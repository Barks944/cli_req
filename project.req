      "id": "REQ-0003",
      "kind": "Functional",
      "links": [],
      "priority": "Must",
      "rationale": "Hash verification is the technical backstop that keeps agents from bypassing conformance checks by editing the file directly.",
      "statement": "The system shall reject loading any .req file whose stored _integrity hash does not match the recomputed SHA-256 of the canonical payload.",
      "status": "Verified",
      "tags": [
        "storage",
        "safety"
      ],
