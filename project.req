      "id": "REQ-0146",
      "kind": "Functional",
      "links": [
        {
          "kind": "DependsOn",
          "target": "REQ-0136"
        }
      ],
      "priority": "Must",
      "rationale": "A reviewer handed a safety-function or safety-requirement id needs to see which hazard it mitigates and how it was verified without walking links by hand; today trace from a leaf shows only the slice rooted there and omits the verification dossier.",
      "statement": "Given a safety function or safety requirement id, req trace shall render the complete hazard-to-verification chain the node belongs to, including the mitigated hazard and each safety requirement's verification dossier.",
      "status": "Verified",
      "tags": [
        "safety",
        "traceability"
      ],
