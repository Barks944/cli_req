    "REQ-0141": {
      "acceptance": [
        "Saving over a file whose _schema_rev exceeds the binary's known revision is refused with an error naming both revisions, leaving the file unchanged",
        "Files without _schema_rev (written before this feature) are treated as revision 0 and save normally"
      ],
