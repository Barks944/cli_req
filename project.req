      "id": "REQ-0148",
      "kind": "Functional",
      "links": [],
      "priority": "Must",
      "rationale": "A safety requirement's verification rests on specific source; once that source changes the prior verification and human sign-off no longer apply, so the requirement must not silently remain Verified.",
      "statement": "req conform shall report a Verified safety requirement whose verified source has drifted as an error until it is re-verified and re-confirmed by a human.",
      "status": "Verified",
      "tags": [
        "safety",
        "verification"
      ],
