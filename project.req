      "id": "REQ-0190",
      "kind": "Functional",
      "links": [],
      "priority": "Must",
      "rationale": "validate is the most overloaded word in req and the one that misleads safety users: it names a consistency linter while the real V&V evidence workflow lands in Verified. A deprecated alias preserves scripts and muscle memory during the transition.",
      "statement": "The whole-project well-formedness command shall be named req conform, outside the verification/validation vocabulary, so that vocabulary is reserved for the evidence workflow.",
      "status": "Verified",
      "tags": [
        "terminology",
        "safety"
      ],
