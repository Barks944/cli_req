      "id": "REQ-0175",
      "kind": "Interface",
      "links": [],
      "priority": "Should",
      "rationale": "Automating capture from a physical test bench requires the bench's test runner to know what the spec expects of it. Emitting the requirements due for verification in a structured payload gives an external system the authoritative list of what to test and the commit that list pertains to, without the spec having to be parsed by hand.",
      "statement": "The tool shall export a machine-readable payload describing the requirements due for verification, including their identifiers, statements, acceptance criteria, and the current commit.",
      "status": "Verified",
      "tags": [
        "test-integration"
      ],
