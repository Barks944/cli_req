      "id": "REQ-0019",
      "kind": "Constraint",
      "links": [],
      "priority": "Must",
      "rationale": "Direct reads encourage agents to skip conformance checking; direct writes break integrity. This is the project's load-bearing constraint.",
      "statement": "The system shall save every `.req` file via temp-and-rename so a mid-write crash cannot corrupt the project.",
      "status": "Obsolete",
      "tags": [
        "agents",
        "safety"
      ],
