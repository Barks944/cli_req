          "kind": "Inspection",
          "linked_files": [
            ".\\src\\cli.rs",
            ".\\tests\\cli.rs"
          ],
          "notes": "validation dossier concluded — REQ-0151 met: no req --help or subcommand --help output contains an id marker of the form (REQ|HAZ|SF|SR)-NNNN:; implementation markers live in non-rendered // comments. Backed by code review and the req_0151 guard test.",
          "outcome": "Pass"
        },
