      "id": "SR-0004",
      "links": [
        {
          "kind": "Realizes",
          "target": "SF-0004"
        }
      ],
      "priority": "Must",
      "rationale": "An actor can record a pass dossier with no genuine analysis or testing; the tool-side defence is to make non-genuine verification visible and revertible so false confidence in the spec is detectable. Realizes the indirect-SIL3 control for HAZ-0002.",
      "statement": "req shall classify and report the verification provenance of every Verified requirement, distinguishing a genuine verification dossier from an audited exemption, stale evidence, or an ungated claim.",
      "status": "Verified",
      "tags": [],
