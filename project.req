    "REQ-0182": {
      "acceptance": [
        "The verdict mapping is declared in `_config.test_integration`, which carries an explicit `version` field, and that version is stamped onto each ingested external record.",
        "An external verdict with no mapping entry is rejected rather than defaulted to pass.",
        "A bench-capability-suspected or operator-override verdict is distinguishable from a plain pass in the resulting record."
      ],
