      "id": "REQ-0208",
      "kind": "Interface",
      "links": [],
      "priority": "Should",
      "rationale": "The at_test bench needs both the requirement set and a place to submit its verdicts, but today an agent must hand-transcribe results into project.req. A live authenticated server closes that loop directly while keeping every write on the same integrity-protected, human-closeout footing as local evidence.",
      "statement": "The tool shall provide a command that serves a project.req to an external test system over an authenticated HTTP endpoint for the duration of a test session.",
      "status": "Implemented",
      "tags": [
        "test-integration",
        "at-test"
      ],
      "tests": [],
      "title": "Serve project.req live to an external test system",
      "updated": "2026-07-09T14:41:16.870865320Z"
    },
