      "id": "SR-0006",
      "links": [
        {
          "kind": "Realizes",
          "target": "SF-0005"
        }
      ],
      "priority": "Must",
      "rationale": "Users asking for validation status reach for the consistency check and read its OK as a V&V pass; the check must disclaim that meaning and route them to the real status report (HAZ-0003).",
      "statement": "A model well-formedness or consistency check shall not present its result as verification or validation status, and shall direct the user to the command that reports the true verification/validation status of every requirement.",
      "status": "Verified",
      "tags": [
        "illustrative"
      ],
