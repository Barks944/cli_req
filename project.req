      "id": "REQ-0173",
      "kind": "Functional",
      "links": [],
      "priority": "Should",
      "rationale": "Acknowledgement is the human judgement the safety governance model exists to protect, so it must be subject to the same human-only constraint as safety acceptance itself. Allowing an agent to acknowledge would let the gate be satisfied without the human review it represents.",
      "statement": "The tool shall refuse to record a safety-walkthrough acknowledgement when the actor kind is agent.",
      "status": "Verified",
      "tags": [
        "guided-review",
        "safety"
      ],
