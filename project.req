      "id": "REQ-0138",
      "kind": "Functional",
      "links": [],
      "priority": "Should",
      "rationale": "A free, unqualified tool must not let an agent enable safety features or accept liability on a user's behalf, and the Annex D table is a worked example that each sector must be able to recalibrate.",
      "statement": "req shall require a human-accepted, committed liability acknowledgement before any functional-safety mutation, deriving SILs from a per-project-overridable risk-graph calibration.",
      "status": "Verified",
      "tags": [
        "safety"
      ],
