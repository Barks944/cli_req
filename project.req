    "REQ-0170": {
      "acceptance": [
        "The walkthrough does not advance past a safety requirement until the reviewer explicitly acknowledges it.",
        "The reviewer can decline a requirement, which records an objection and halts acceptance for that chain.",
        "Progress can be interrupted and resumed without losing prior acknowledgements."
      ],
